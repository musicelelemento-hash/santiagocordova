{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/nube.cjs",
            "timeout": 600,
            "statusMessage": "Preparando la web en la nube (dependencias)..."
          }
        ]
      }
    ]
  }
}
